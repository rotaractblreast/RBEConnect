{
  "id": "connect.rotaractblreast.org",
  "name": "RBE Connect — Reviewer Portal",
  "short_name": "RBE Connect",
  "description": "Rotaract Club of Bangalore East Reviewer Portal for Member Applications & Subscribers",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fff8f5",
  "theme_color": "#ff9000",
  "categories": ["business", "productivity", "utilities"],
  "shortcuts": [
    {
      "name": "View Applications",
      "short_name": "Applications",
      "description": "Review new and pending candidate applications",
      "url": "/#applications",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "View Subscribers",
      "short_name": "Subscribers",
      "description": "Browse newsletter subscribers and contact messages",
      "url": "/#subscribers",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
